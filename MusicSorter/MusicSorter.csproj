<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>MusicSorter</RootNamespace>
    <AssemblyName>MusicSorter</AssemblyName>

    <!-- Version + identity. Populates the .exe's Win32 version resource so
         SmartScreen / Smart App Control don't see a "no publisher info" binary. -->
    <Version>1.1.0</Version>
    <FileVersion>1.1.0.0</FileVersion>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <InformationalVersion>1.1.0</InformationalVersion>
    <Authors>Music Sorter contributors</Authors>
    <Company>Music Sorter</Company>
    <Product>Music Sorter</Product>
    <Copyright>Copyright (c) Music Sorter contributors</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>
    <Description>Sort, rename and enrich music files (YouTube rips etc.) using filename cleanup, MusicBrainz, AcoustID and Shazam.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- WPF cannot load native dependencies from inside a bundle, so the single-file
         host has to extract them on first run. This is required for WPF apps. -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <!-- Compression is disabled: it has caused first-run extraction failures on some
         Windows configurations and we'd rather ship a slightly bigger .exe that boots. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

</Project>
