<Window x:Class="MusicSorter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Music Sorter" Height="860" Width="940"
        Background="{DynamicResource BgBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto" MinHeight="0" MaxHeight="540"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Music Sorter"
                   FontSize="22" FontWeight="Bold" Margin="0,0,0,12"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Folders -->
                <GroupBox Header="Folders">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="Source:" VerticalAlignment="Center"/>
                        <TextBox  Grid.Row="0" Grid.Column="1" x:Name="SourceBox" Margin="0,3"/>
                        <Button   Grid.Row="0" Grid.Column="2" Content="Browse..." Click="BrowseSource_Click" Margin="6,3,0,3"/>

                        <Label Grid.Row="1" Grid.Column="0" Content="Output:" VerticalAlignment="Center"/>
                        <TextBox  Grid.Row="1" Grid.Column="1" x:Name="OutputBox" Margin="0,3"/>
                        <Button   Grid.Row="1" Grid.Column="2" Content="Browse..." Click="BrowseOutput_Click" Margin="6,3,0,3"/>
                    </Grid>
                </GroupBox>

                <!-- Layout -->
                <GroupBox Header="Output structure">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Label Grid.Row="0" Grid.Column="0" Content="Folder layout:"  VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="LayoutCombo" Margin="0,3"/>
                        <Label Grid.Row="1" Grid.Column="0" Content="File name:" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="FilenameCombo" Margin="0,3"/>

                        <Label Grid.Row="2" Grid.Column="0" Content="Per-folder cap:" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                            <CheckBox x:Name="ChkFolderCap" Content="Limit files per folder to"
                                      VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="FolderCapBox" Text="99" Width="60"
                                     VerticalContentAlignment="Center"
                                     ToolTip="When a leaf folder fills up, the next files go to 'Folder (2)', '(3)', ..."/>
                            <TextBlock Text="  files"
                                       Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- Identification -->
                <GroupBox Header="Identification methods (cascade until a confident match is found)">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <CheckBox Grid.Row="0" Grid.Column="0" x:Name="ChkClean"        IsChecked="True" Content="1. Clean filename (strip 'Official Music Video', '[Lyrics]', uploader names...)"/>
                        <CheckBox Grid.Row="1" Grid.Column="0" x:Name="ChkMusicBrainz"  IsChecked="True" Content="2. MusicBrainz lookup (free, no key)"/>
                        <CheckBox Grid.Row="0" Grid.Column="1" x:Name="ChkAcoustId"     IsChecked="True" Content="3. AcoustID fingerprint (needs fpcalc.exe + key)"/>
                        <CheckBox Grid.Row="1" Grid.Column="1" x:Name="ChkShazam"       IsChecked="True" Content="4. Shazam (RapidAPI, needs key)"/>
                    </Grid>
                </GroupBox>

                <!-- Output mode (tags + art) -->
                <GroupBox Header="What to write to the destination file">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label    Grid.Row="0" Grid.Column="0" Content="ID3 tags:"  VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="TagModeCombo" Margin="0,3"/>

                        <Label    Grid.Row="1" Grid.Column="0" Content="Cover art:" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="ArtModeCombo" Margin="0,3"/>

                        <CheckBox Grid.Row="2" Grid.Column="1" x:Name="ChkSkipExisting" IsChecked="True"
                                  Content="Skip if a file already exists at the destination path" Margin="0,4,0,0"/>
                    </Grid>
                </GroupBox>

                <!-- Duplicates -->
                <GroupBox Header="Duplicate handling">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <CheckBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" x:Name="ChkDedup" IsChecked="True"
                                  Content="Detect duplicates and remove the lower-quality copy"
                                  FontWeight="SemiBold" Margin="0,0,0,4"/>

                        <Label    Grid.Row="1" Grid.Column="0" Content="Match by:" VerticalAlignment="Top" Margin="0,4,0,0"/>
                        <WrapPanel Grid.Row="1" Grid.Column="1">
                            <CheckBox x:Name="ChkDupAT"   IsChecked="True"  Content="Artist + Title"      Margin="0,0,16,0"/>
                            <CheckBox x:Name="ChkDupMbid" IsChecked="True"  Content="Recording / MBID"    Margin="0,0,16,0"/>
                            <CheckBox x:Name="ChkDupDur"  IsChecked="True"  Content="Artist + Duration ±2s" Margin="0,0,16,0"/>
                            <CheckBox x:Name="ChkDupHash" IsChecked="True"  Content="File hash (SHA-1)"   Margin="0,0,16,0"/>
                            <CheckBox x:Name="ChkHashLib" IsChecked="False" Content="...also hash existing library (slow)"/>
                        </WrapPanel>

                        <Label    Grid.Row="2" Grid.Column="0" Content="Action:" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="DupActionCombo" Margin="0,3"/>

                        <CheckBox Grid.Row="3" Grid.Column="1" x:Name="ChkDupRecycle" IsChecked="True"
                                  Content="Send removed duplicates to Recycle Bin (uncheck for permanent delete)"
                                  Margin="0,4,0,0"/>
                    </Grid>
                </GroupBox>

                <!-- API keys -->
                <GroupBox Header="API keys (saved to %APPDATA%\MusicSorter\settings.json)">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label    Grid.Row="0" Grid.Column="0" Content="AcoustID API key:" VerticalAlignment="Center"/>
                        <TextBox  Grid.Row="0" Grid.Column="1" x:Name="AcoustIdKeyBox" Margin="0,3"/>
                        <Label    Grid.Row="0" Grid.Column="2" Content="RapidAPI / Shazam key:" VerticalAlignment="Center"/>
                        <TextBox  Grid.Row="0" Grid.Column="3" x:Name="ShazamKeyBox" Margin="0,3"/>

                        <Label    Grid.Row="1" Grid.Column="0" Content="fpcalc.exe path:" VerticalAlignment="Center"/>
                        <TextBox  Grid.Row="1" Grid.Column="1" x:Name="FpcalcBox" Margin="0,3"
                                  ToolTip="Leave blank to look up fpcalc.exe on PATH or next to MusicSorter.exe"/>
                        <Label    Grid.Row="1" Grid.Column="2" Content="Shazam host:" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="1" Grid.Column="3" x:Name="ShazamHostCombo" Margin="0,3"
                                  IsEditable="True" IsTextSearchEnabled="False"/>
                    </Grid>
                </GroupBox>

                <!-- File mode -->
                <GroupBox Header="File operation">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="RbMove" Content="Move (cut originals)" GroupName="Mode" IsChecked="True"/>
                        <RadioButton x:Name="RbCopy" Content="Copy (keep originals)" GroupName="Mode"/>
                        <TextBlock Text="  Unmatched files go to '_Unsorted' under the output."
                                   Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="20,0,0,0"/>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- Log -->
        <GroupBox Grid.Row="2" Header="Activity log" Margin="0,10,0,0">
            <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="12" Background="#0F0F13"/>
        </GroupBox>

        <!-- Bottom action bar -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ProgressBar Grid.Column="0" x:Name="Progress" Height="22" Minimum="0" Maximum="100"
                         Foreground="{DynamicResource AccentBrush}" Background="#15151A"/>
            <Button Grid.Column="1" x:Name="StartBtn" Content="Start" Click="StartBtn_Click" Margin="10,0,0,0" MinWidth="90"/>
            <Button Grid.Column="2" x:Name="CancelBtn" Content="Cancel" Click="CancelBtn_Click" Margin="6,0,0,0" MinWidth="90"
                    IsEnabled="False" Background="#E57373"/>
        </Grid>
    </Grid>
</Window>
