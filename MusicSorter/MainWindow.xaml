<Window x:Class="MusicSorter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Music Sorter" Height="900" Width="960"
        MinHeight="700" MinWidth="820"
        Background="{DynamicResource WindowBg}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Grid Margin="20,14,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header bar -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="44" Height="44"
                    Background="{DynamicResource AccentGradient}"
                    CornerRadius="10" Margin="0,0,12,0">
                <TextBlock Text="&#x266B;" FontSize="22" FontWeight="Bold"
                           Foreground="#0E1419"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Music Sorter"
                           FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="Sort, rename and tag your music. Cleans YouTube cruft, looks up MusicBrainz / AcoustID / Shazam, removes duplicates."
                           FontSize="12"
                           Foreground="{DynamicResource MutedBrush}"
                           Margin="0,2,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="1">
            <TabItem Header="SORT">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" MinHeight="0" MaxHeight="540"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Folders -->
                <GroupBox Header="FOLDERS">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="Source:" VerticalAlignment="Center"/>
                        <TextBox  Grid.Row="0" Grid.Column="1" x:Name="SourceBox" Margin="0,3"/>
                        <Button   Grid.Row="0" Grid.Column="2" Content="Browse..." Click="BrowseSource_Click" Margin="6,3,0,3"/>

                        <Label Grid.Row="1" Grid.Column="0" Content="Output:" VerticalAlignment="Center"/>
                        <TextBox  Grid.Row="1" Grid.Column="1" x:Name="OutputBox" Margin="0,3"/>
                        <Button   Grid.Row="1" Grid.Column="2" Content="Browse..." Click="BrowseOutput_Click" Margin="6,3,0,3"/>
                    </Grid>
                </GroupBox>

                <!-- Layout -->
                <GroupBox Header="OUTPUT STRUCTURE">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Label Grid.Row="0" Grid.Column="0" Content="Folder layout:"  VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="LayoutCombo" Margin="0,3"/>
                        <Label Grid.Row="1" Grid.Column="0" Content="File name:" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="FilenameCombo" Margin="0,3"/>

                        <Label Grid.Row="2" Grid.Column="0" Content="Per-folder cap:" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                            <CheckBox x:Name="ChkFolderCap" Content="Limit files per folder to"
                                      VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="FolderCapBox" Text="99" Width="60"
                                     VerticalContentAlignment="Center"
                                     IsEnabled="{Binding IsChecked, ElementName=ChkFolderCap}"
                                     ToolTip="When a leaf folder fills up, the next files go to 'Folder (2)', '(3)', ..."/>
                            <TextBlock Text="  files"
                                       Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- Identification -->
                <GroupBox Header="IDENTIFICATION  ·  cascade until a confident match is found">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <CheckBox Grid.Row="0" Grid.Column="0" x:Name="ChkClean"        IsChecked="True" Content="1. Clean filename (strip 'Official Music Video', '[Lyrics]', uploader names...)"/>
                        <CheckBox Grid.Row="1" Grid.Column="0" x:Name="ChkMusicBrainz"  IsChecked="True" Content="2. MusicBrainz lookup (free, no key)"/>
                        <CheckBox Grid.Row="0" Grid.Column="1" x:Name="ChkAcoustId"     IsChecked="True" Content="3. AcoustID fingerprint (needs fpcalc.exe + key)"/>
                        <CheckBox Grid.Row="1" Grid.Column="1" x:Name="ChkShazam"       IsChecked="True" Content="4. Shazam (RapidAPI, needs key)"/>
                    </Grid>
                </GroupBox>

                <!-- Output mode (tags + art) -->
                <GroupBox Header="OUTPUT FILE  ·  tags + cover art">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label    Grid.Row="0" Grid.Column="0" Content="ID3 tags:"  VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="TagModeCombo" Margin="0,3"/>

                        <Label    Grid.Row="1" Grid.Column="0" Content="Cover art:" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="ArtModeCombo" Margin="0,3"/>

                        <CheckBox Grid.Row="2" Grid.Column="1" x:Name="ChkSkipExisting" IsChecked="True"
                                  Content="Skip if a file already exists at the destination path" Margin="0,4,0,0"/>
                    </Grid>
                </GroupBox>

                <!-- Duplicates -->
                <GroupBox Header="DUPLICATE HANDLING">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <CheckBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" x:Name="ChkDedup" IsChecked="True"
                                  Content="Detect duplicates and remove the lower-quality copy"
                                  FontWeight="SemiBold" Margin="0,0,0,4"/>

                        <Label    Grid.Row="1" Grid.Column="0" Content="Match by:" VerticalAlignment="Top" Margin="0,4,0,0"
                                  IsEnabled="{Binding IsChecked, ElementName=ChkDedup}"/>
                        <WrapPanel Grid.Row="1" Grid.Column="1"
                                   IsEnabled="{Binding IsChecked, ElementName=ChkDedup}">
                            <CheckBox x:Name="ChkDupAT"   IsChecked="True"  Content="Artist + Title"      Margin="0,0,16,0"/>
                            <CheckBox x:Name="ChkDupMbid" IsChecked="True"  Content="Recording / MBID"    Margin="0,0,16,0"/>
                            <CheckBox x:Name="ChkDupDur"  IsChecked="True"  Content="Artist + Duration ±2s" Margin="0,0,16,0"/>
                            <CheckBox x:Name="ChkDupHash" IsChecked="True"  Content="File hash (SHA-1)"   Margin="0,0,16,0"/>
                            <CheckBox x:Name="ChkHashLib" IsChecked="False" Content="...also hash existing library (slow)"/>
                        </WrapPanel>

                        <Label    Grid.Row="2" Grid.Column="0" Content="Action:" VerticalAlignment="Center"
                                  IsEnabled="{Binding IsChecked, ElementName=ChkDedup}"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="DupActionCombo" Margin="0,3"
                                  IsEnabled="{Binding IsChecked, ElementName=ChkDedup}"/>

                        <CheckBox Grid.Row="3" Grid.Column="1" x:Name="ChkDupRecycle" IsChecked="True"
                                  Content="Send removed duplicates to Recycle Bin (uncheck for permanent delete)"
                                  Margin="0,4,0,0"
                                  IsEnabled="{Binding IsChecked, ElementName=ChkDedup}"/>
                    </Grid>
                </GroupBox>

                <!-- API keys -->
                <GroupBox Header="API KEYS  ·  saved to %APPDATA%\MusicSorter\settings.json">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label    Grid.Row="0" Grid.Column="0" Content="AcoustID API key:" VerticalAlignment="Center"/>
                        <TextBox  Grid.Row="0" Grid.Column="1" x:Name="AcoustIdKeyBox" Margin="0,3"/>
                        <Label    Grid.Row="0" Grid.Column="2" Content="RapidAPI / Shazam key:" VerticalAlignment="Center"/>
                        <TextBox  Grid.Row="0" Grid.Column="3" x:Name="ShazamKeyBox" Margin="0,3"/>

                        <Label    Grid.Row="1" Grid.Column="0" Content="fpcalc.exe path:" VerticalAlignment="Center"/>
                        <TextBox  Grid.Row="1" Grid.Column="1" x:Name="FpcalcBox" Margin="0,3"
                                  ToolTip="Leave blank to look up fpcalc.exe on PATH or next to MusicSorter.exe"/>
                        <Label    Grid.Row="1" Grid.Column="2" Content="Shazam host:" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="1" Grid.Column="3" x:Name="ShazamHostCombo" Margin="0,3"
                                  IsEditable="True" IsTextSearchEnabled="False"/>
                    </Grid>
                </GroupBox>

                <!-- File mode -->
                <GroupBox Header="FILE OPERATION">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="RbMove" Content="Move (cut originals)" GroupName="Mode" IsChecked="True"/>
                            <RadioButton x:Name="RbCopy" Content="Copy (keep originals)" GroupName="Mode"/>
                        </StackPanel>
                        <CheckBox x:Name="ChkLetterFallback" IsChecked="True"
                                  Content="If identification fails, bucket the file by the first letter of its cleaned filename (e.g. R\Random YouTube weirdness.mp3) instead of dumping into _Unsorted\"
                                  Margin="0,6,0,0"/>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- KPI dashboard + log -->
        <Grid Grid.Row="1" Margin="0,4,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- KPI cards: matched / bucketed / duplicates / failed -->
            <UniformGrid Grid.Row="0" Rows="1" Columns="4" Margin="0,0,-8,8">
                <Border Style="{DynamicResource KpiCard}">
                    <StackPanel>
                        <TextBlock x:Name="KpiMatchedNum" Style="{DynamicResource KpiNumber}"
                                   Foreground="{DynamicResource SuccessBrush}" Text="—"/>
                        <TextBlock Style="{DynamicResource KpiLabel}" Text="MATCHED"/>
                        <TextBlock x:Name="KpiMatchedSub" Style="{DynamicResource KpiSubtitle}"
                                   Text="ready to start" />
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource KpiCard}">
                    <StackPanel>
                        <TextBlock x:Name="KpiBucketedNum" Style="{DynamicResource KpiNumber}"
                                   Foreground="{DynamicResource WarnBrush}" Text="—"/>
                        <TextBlock Style="{DynamicResource KpiLabel}" Text="BUCKETED / UNSORTED"/>
                        <TextBlock x:Name="KpiBucketedSub" Style="{DynamicResource KpiSubtitle}"
                                   Text="letter fallback or _Unsorted"/>
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource KpiCard}">
                    <StackPanel>
                        <TextBlock x:Name="KpiDupesNum" Style="{DynamicResource KpiNumber}"
                                   Foreground="{DynamicResource InfoBrush}" Text="—"/>
                        <TextBlock Style="{DynamicResource KpiLabel}" Text="DUPLICATES"/>
                        <TextBlock x:Name="KpiDupesSub" Style="{DynamicResource KpiSubtitle}"
                                   Text="removed"/>
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource KpiCard}" Margin="0,0,0,0">
                    <StackPanel>
                        <TextBlock x:Name="KpiFailedNum" Style="{DynamicResource KpiNumber}"
                                   Foreground="{DynamicResource DangerBrush}" Text="—"/>
                        <TextBlock Style="{DynamicResource KpiLabel}" Text="FAILED"/>
                        <TextBlock x:Name="KpiFailedSub" Style="{DynamicResource KpiSubtitle}"
                                   Text="errors"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Status strip: total / skipped / elapsed / rate -->
            <Grid Grid.Row="1" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="StatusLeft"
                           Foreground="{DynamicResource MutedBrush}" FontSize="11"
                           VerticalAlignment="Center"
                           Text="ready · 0 / 0 files"/>
                <TextBlock Grid.Column="2" x:Name="StatusRight"
                           Foreground="{DynamicResource MutedBrush}" FontSize="11"
                           VerticalAlignment="Center"
                           Text="—"/>
            </Grid>

            <!-- Log -->
            <GroupBox Grid.Row="2" Header="ACTIVITY LOG">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <CheckBox x:Name="ChkCompactLog" IsChecked="False"
                                  Content="Compact (hide per-step enrichment lines)"
                                  Margin="0,0,16,0"/>
                        <Button x:Name="ClearLogBtn" Content="Clear log"
                                Style="{DynamicResource GhostButton}"
                                Padding="8,3" MinWidth="0"
                                Click="ClearLogBtn_Click"/>
                        <Button x:Name="CopyLogBtn" Content="Copy"
                                Style="{DynamicResource GhostButton}"
                                Padding="8,3" MinWidth="0" Margin="6,0,0,0"
                                Click="CopyLogBtn_Click"/>
                    </StackPanel>
                    <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Cascadia Code, Consolas, Menlo, monospace"
                             FontSize="12"
                             Padding="8,6"/>
                </DockPanel>
            </GroupBox>
        </Grid>

        <!-- Bottom action bar -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ProgressBar Grid.Column="0" x:Name="Progress" VerticalAlignment="Center"
                         Minimum="0" Maximum="100"/>
            <Button Grid.Column="1" x:Name="StartBtn" Content="Start"
                    Click="StartBtn_Click" Margin="14,0,0,0" MinWidth="100"
                    IsDefault="True"
                    ToolTip="Start the sort (Enter)"/>
            <Button Grid.Column="2" x:Name="CancelBtn" Content="Cancel"
                    Style="{DynamicResource GhostButton}"
                    Click="CancelBtn_Click" Margin="8,0,0,0" MinWidth="100"
                    IsCancel="True"
                    IsEnabled="False"
                    ToolTip="Cancel the running sort (Esc)"/>
        </Grid>
            </Grid>
            </TabItem>

            <!-- ============================ ANALYZE tab ====================== -->
            <TabItem Header="ANALYZE">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Library picker -->
                    <GroupBox Grid.Row="0" Header="LIBRARY" Margin="0,4,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="Folder:" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="AnalyzeFolderBox" Margin="0,3"/>
                            <Button  Grid.Column="2" Content="Browse..." Click="BrowseAnalyzeFolder_Click" Margin="6,3,0,3"/>
                        </Grid>
                    </GroupBox>

                    <!-- KPI cards -->
                    <UniformGrid Grid.Row="1" Rows="1" Columns="4" Margin="0,0,-8,10">
                        <Border Style="{DynamicResource KpiCard}">
                            <StackPanel>
                                <TextBlock x:Name="AnFilesNum" Style="{DynamicResource KpiNumber}" Text="—"/>
                                <TextBlock Style="{DynamicResource KpiLabel}" Text="MP3 FILES"/>
                                <TextBlock x:Name="AnFilesSub" Style="{DynamicResource KpiSubtitle}" Text="press Analyze to scan"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{DynamicResource KpiCard}">
                            <StackPanel>
                                <TextBlock x:Name="AnSizeNum"  Style="{DynamicResource KpiNumber}"
                                           Foreground="{DynamicResource AccentBrush}" Text="—"/>
                                <TextBlock Style="{DynamicResource KpiLabel}" Text="TOTAL SIZE"/>
                                <TextBlock x:Name="AnSizeSub"  Style="{DynamicResource KpiSubtitle}" Text="—"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{DynamicResource KpiCard}">
                            <StackPanel>
                                <TextBlock x:Name="AnDurNum"   Style="{DynamicResource KpiNumber}"
                                           Foreground="{DynamicResource SuccessBrush}" Text="—"/>
                                <TextBlock Style="{DynamicResource KpiLabel}" Text="DURATION"/>
                                <TextBlock x:Name="AnDurSub"   Style="{DynamicResource KpiSubtitle}" Text="—"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{DynamicResource KpiCard}">
                            <StackPanel>
                                <TextBlock x:Name="AnBitrateNum" Style="{DynamicResource KpiNumber}"
                                           Foreground="{DynamicResource InfoBrush}" Text="—"/>
                                <TextBlock Style="{DynamicResource KpiLabel}" Text="AVG BITRATE"/>
                                <TextBlock x:Name="AnBitrateSub" Style="{DynamicResource KpiSubtitle}" Text="kbps"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Body: completeness + tops + issues -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Tag completeness meters -->
                            <GroupBox Header="TAG COMPLETENESS">
                                <Grid x:Name="AnCompletenessGrid">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Title"        Style="{DynamicResource MeterLabel}" Margin="0,4"/>
                                    <ProgressBar Grid.Row="0" Grid.Column="1" x:Name="AnTitleBar"   Style="{DynamicResource MeterBar}" Margin="0,4"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" x:Name="AnTitleVal"  Style="{DynamicResource MeterValue}" Margin="8,4,0,4" Text="—"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Artist"       Style="{DynamicResource MeterLabel}" Margin="0,4"/>
                                    <ProgressBar Grid.Row="1" Grid.Column="1" x:Name="AnArtistBar"  Style="{DynamicResource MeterBar}" Margin="0,4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" x:Name="AnArtistVal" Style="{DynamicResource MeterValue}" Margin="8,4,0,4" Text="—"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Album"        Style="{DynamicResource MeterLabel}" Margin="0,4"/>
                                    <ProgressBar Grid.Row="2" Grid.Column="1" x:Name="AnAlbumBar"   Style="{DynamicResource MeterBar}" Margin="0,4"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" x:Name="AnAlbumVal"  Style="{DynamicResource MeterValue}" Margin="8,4,0,4" Text="—"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Album Artist" Style="{DynamicResource MeterLabel}" Margin="0,4"/>
                                    <ProgressBar Grid.Row="3" Grid.Column="1" x:Name="AnAABar"     Style="{DynamicResource MeterBar}" Margin="0,4"/>
                                    <TextBlock Grid.Row="3" Grid.Column="2" x:Name="AnAAVal"     Style="{DynamicResource MeterValue}" Margin="8,4,0,4" Text="—"/>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Year"         Style="{DynamicResource MeterLabel}" Margin="0,4"/>
                                    <ProgressBar Grid.Row="4" Grid.Column="1" x:Name="AnYearBar"    Style="{DynamicResource MeterBar}" Margin="0,4"/>
                                    <TextBlock Grid.Row="4" Grid.Column="2" x:Name="AnYearVal"   Style="{DynamicResource MeterValue}" Margin="8,4,0,4" Text="—"/>
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Genre"        Style="{DynamicResource MeterLabel}" Margin="0,4"/>
                                    <ProgressBar Grid.Row="5" Grid.Column="1" x:Name="AnGenreBar"   Style="{DynamicResource MeterBar}" Margin="0,4"/>
                                    <TextBlock Grid.Row="5" Grid.Column="2" x:Name="AnGenreVal"  Style="{DynamicResource MeterValue}" Margin="8,4,0,4" Text="—"/>
                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Track #"      Style="{DynamicResource MeterLabel}" Margin="0,4"/>
                                    <ProgressBar Grid.Row="6" Grid.Column="1" x:Name="AnTrackBar"   Style="{DynamicResource MeterBar}" Margin="0,4"/>
                                    <TextBlock Grid.Row="6" Grid.Column="2" x:Name="AnTrackVal"  Style="{DynamicResource MeterValue}" Margin="8,4,0,4" Text="—"/>
                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="MBID"         Style="{DynamicResource MeterLabel}" Margin="0,4"/>
                                    <ProgressBar Grid.Row="7" Grid.Column="1" x:Name="AnMbidBar"    Style="{DynamicResource MeterBar}" Margin="0,4"/>
                                    <TextBlock Grid.Row="7" Grid.Column="2" x:Name="AnMbidVal"   Style="{DynamicResource MeterValue}" Margin="8,4,0,4" Text="—"/>
                                </Grid>
                            </GroupBox>

                            <!-- Top genres + artists -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <GroupBox Grid.Column="0" Header="TOP GENRES" Margin="0,0,5,0">
                                    <ListBox x:Name="AnGenresList" Background="Transparent" BorderThickness="0"
                                             Foreground="{DynamicResource TextBrush}" MaxHeight="220"/>
                                </GroupBox>
                                <GroupBox Grid.Column="1" Header="TOP ARTISTS" Margin="5,0,0,0">
                                    <ListBox x:Name="AnArtistsList" Background="Transparent" BorderThickness="0"
                                             Foreground="{DynamicResource TextBrush}" MaxHeight="220"/>
                                </GroupBox>
                            </Grid>

                            <!-- Issues -->
                            <GroupBox Header="ISSUES FOUND">
                                <StackPanel x:Name="AnIssuesPanel">
                                    <TextBlock Text="Run an analysis to populate this section."
                                               Foreground="{DynamicResource SubtleBrush}" FontSize="12"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="BITRATE DISTRIBUTION">
                                <Grid x:Name="AnBitrateGrid">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="&lt; 128 kbps" Style="{DynamicResource MeterLabel}" Margin="0,4"/>
                                    <ProgressBar Grid.Row="0" Grid.Column="1" x:Name="AnBr1Bar" Style="{DynamicResource MeterBar}" Margin="0,4"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" x:Name="AnBr1Val" Style="{DynamicResource MeterValue}" Margin="8,4,0,4" Text="—"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="128 kbps" Style="{DynamicResource MeterLabel}" Margin="0,4"/>
                                    <ProgressBar Grid.Row="1" Grid.Column="1" x:Name="AnBr2Bar" Style="{DynamicResource MeterBar}" Margin="0,4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" x:Name="AnBr2Val" Style="{DynamicResource MeterValue}" Margin="8,4,0,4" Text="—"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="192 kbps" Style="{DynamicResource MeterLabel}" Margin="0,4"/>
                                    <ProgressBar Grid.Row="2" Grid.Column="1" x:Name="AnBr3Bar" Style="{DynamicResource MeterBar}" Margin="0,4"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" x:Name="AnBr3Val" Style="{DynamicResource MeterValue}" Margin="8,4,0,4" Text="—"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="256 kbps" Style="{DynamicResource MeterLabel}" Margin="0,4"/>
                                    <ProgressBar Grid.Row="3" Grid.Column="1" x:Name="AnBr4Bar" Style="{DynamicResource MeterBar}" Margin="0,4"/>
                                    <TextBlock Grid.Row="3" Grid.Column="2" x:Name="AnBr4Val" Style="{DynamicResource MeterValue}" Margin="8,4,0,4" Text="—"/>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="320 kbps" Style="{DynamicResource MeterLabel}" Margin="0,4"/>
                                    <ProgressBar Grid.Row="4" Grid.Column="1" x:Name="AnBr5Bar" Style="{DynamicResource MeterBar}" Margin="0,4"/>
                                    <TextBlock Grid.Row="4" Grid.Column="2" x:Name="AnBr5Val" Style="{DynamicResource MeterValue}" Margin="8,4,0,4" Text="—"/>
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="&gt; 320 kbps" Style="{DynamicResource MeterLabel}" Margin="0,4"/>
                                    <ProgressBar Grid.Row="5" Grid.Column="1" x:Name="AnBr6Bar" Style="{DynamicResource MeterBar}" Margin="0,4"/>
                                    <TextBlock Grid.Row="5" Grid.Column="2" x:Name="AnBr6Val" Style="{DynamicResource MeterValue}" Margin="8,4,0,4" Text="—"/>
                                </Grid>
                            </GroupBox>

                            <!-- Live status / log -->
                            <GroupBox Header="ANALYZE LOG">
                                <TextBox x:Name="AnLogBox" IsReadOnly="True" TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         FontFamily="Cascadia Code, Consolas, Menlo, monospace"
                                         FontSize="12" Padding="8,6" MinHeight="120"/>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Action bar -->
                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar Grid.Column="0" x:Name="AnProgress" VerticalAlignment="Center"
                                     Minimum="0" Maximum="100"/>
                        <Button Grid.Column="1" x:Name="AnalyzeBtn" Content="Analyze"
                                Click="AnalyzeBtn_Click" Margin="14,0,0,0" MinWidth="100"/>
                        <Button Grid.Column="2" x:Name="AnCancelBtn" Content="Cancel"
                                Style="{DynamicResource GhostButton}"
                                Click="AnCancelBtn_Click" Margin="8,0,0,0" MinWidth="100"
                                IsEnabled="False"/>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
